{
  "name": "speed-o-freq-sonic",
  "version": "2.6.0",
  "description": "Speed-o'-Freq Sonic download manager",
  "main": "./out/main/index.js",
  "author": "Speed-o'-Freq Sonic",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "typecheck:extension": "tsc -p extension/tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:e2e && npm run typecheck:extension",
    "prestart": "install-electron",
    "start": "electron-vite preview",
    "predev": "install-electron",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "patch-package && install-electron && electron-builder install-app-deps",
    "security:gate": "node scripts/security-audit-gate.mjs",
    "prebuild:unpack": "npm run security:gate",
    "prebuild:win": "set SONIC_REQUIRE_CODE_SIGNING=1&& npm run security:gate",
    "prebuild:mac": "npm run security:gate",
    "prebuild:linux": "npm run security:gate",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:extension": "node extension/build.mjs",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:ip-security": "node --test tests/ip-security.test.mjs",
    "test:security": "node --test tests/*.test.mjs",
    "generate:notices": "node scripts/generate-third-party-notices.mjs && prettier --write THIRD_PARTY_NOTICES.md",
    "generate:sbom": "node scripts/generate-package-sbom.mjs",
    "generate:package-sbom": "node scripts/generate-package-sbom.mjs",
    "benchmark:app": "playwright test e2e/ui.spec.ts --grep @benchmark --reporter=line"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@electron-toolkit/utils": "^4.0.0",
    "basic-ftp": "^6.2.3",
    "bittorrent-peerid": "2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.2",
    "ipaddr.js": "2.5.0",
    "koffi": "^2.16.3",
    "lucide-react": "^1.60.0",
    "parse-torrent": "^11.0.24",
    "react-day-picker": "^10.0.2",
    "selfsigned": "^5.5.0",
    "tailwind-merge": "^3.7.0",
    "webtorrent": "^3.0.21",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.4",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "axe-core": "^4.14.0",
    "electron": "^44.4.4",
    "electron-builder": "^26.16.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fast-check": "^4.10.1",
    "patch-package": "8.0.1",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "node-datachannel@0.32.3": true,
    "koffi@2.16.3": true
  }
}
