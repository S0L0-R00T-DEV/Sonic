{
    "name": "sonic",
    "version": "1.0.0",
    "description": "Sonic download manager",
    "main": "./out/main/index.js",
    "author": "Sonic",
    "scripts": {
        "prestart": "install-electron",
        "start": "electron-vite preview",
        "predev": "install-electron",
        "dev": "electron-vite dev",
        "postinstall": "install-electron && electron-builder install-app-deps",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
        "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
        "typecheck:extension": "tsc -p extension/tsconfig.json",
        "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:extension",
        "build": "npm run typecheck && npm run build:extension && electron-vite build",
        "build:extension": "node extension/build.mjs",
        "generate:notices": "node scripts/generate-third-party-notices.mjs",
        "lint": "eslint src extension",
        "format": "prettier --write \"src/**/*.{ts,tsx,html,css}\" \"extension/**/*.{ts,js,json,html,css}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,html,css}\" \"extension/**/*.{ts,js,json,html,css}\""
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@electron-toolkit/utils": "^4.0.0",
        "basic-ftp": "^6.2.3",
        "bittorrent-peerid": "2.0.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "fast-xml-parser": "^5.11.2",
        "ipaddr.js": "2.5.0",
        "koffi": "^2.16.3",
        "lucide-react": "^1.60.0",
        "parse-torrent": "^11.0.24",
        "react-day-picker": "^10.0.2",
        "selfsigned": "^5.5.0",
        "tailwind-merge": "^3.7.0",
        "webtorrent": "^3.0.21",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@electron-toolkit/eslint-config-prettier": "^3.0.0",
        "@electron-toolkit/eslint-config-ts": "^3.1.0",
        "@electron-toolkit/tsconfig": "^2.0.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/chrome": "^0.3.4",
        "@types/node": "^22.19.1",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.1",
        "axe-core": "^4.14.0",
        "electron": "^44.4.4",
        "electron-builder": "^26.16.1",
        "electron-vite": "^5.0.0",
        "eslint": "^9.39.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "fast-check": "^4.10.2",
        "ip": "npm:@bybrave/ip2@3.1.0",
        "prettier": "^3.7.4",
        "react": "^19.2.1",
        "react-dom": "^19.2.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "vite": "^7.2.6"
    },
    "overrides": {
        "ip": "npm:@bybrave/ip2@3.1.0"
    },
    "allowScripts": {
        "electron@39.8.10": true,
        "electron-winstaller@5.4.0": true,
        "esbuild@0.25.12": true,
        "esbuild@0.28.2": true,
        "fsevents@2.3.3": true,
        "node-datachannel@0.32.3": true,
        "koffi@2.16.3": true
    }
}
